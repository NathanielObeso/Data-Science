#| label: removing the massive outlier in terms of Price
SoCalRent2025_1 <- SoCalRent2025 %>%
filter(price < 30000)
SoCalRent2025_1 %>%
group_by(county) %>%
summarize(
mean_price = mean(price)
)
SoCalRent2025_1 %>%
summarize(
min_price = min(price),
q1_price = quantile(price, 0.25),
med_price = median(price),
q3_price = quantile(price, 0.75),
max_price = max(price)
)
SoCalRent2025_minimums <- SoCalRent2025 %>%
filter(!is.na(`sq ft`)) %>%
mutate(
`sq ft` = as.numeric(str_extract(`sq ft`, "[0-9]+"))
)
SoCalRent2025 %>%
filter(!is.na(`sq ft`)) %>%
mutate(
`sq ft` = if_else(str_detect(`sq ft`, "-"),
true = str_remove(str_extract(`sq ft`, "-[0-9]+$"), "-"),
false = str_extract(`sq ft`, "[0-9]+")
)
) %>%
select(`sq ft`)
