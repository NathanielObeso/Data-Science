#| label: plot that explores relationship between ray diameter and number of rays
ggplot(
data = encelia_train,
mapping = aes(y = number_rays,
x = ray_diameter,
color = Species,
shape = Species
)
) +
geom_point() +
labs(
title = "Number of Rays vs Ray Diameter",
y = "Number of Rays",
x = "Ray Diameter (cm)"
) +
scale_color_manual(
values = c("#fdb827", "#542583")
) +
scale_shape_manual(
values = c(1, 17)
) +
geom_smooth(method = "loess", se = FALSE)
