pars = c("countyOC", "countyRIV"),
plotfun = "hist",
bins = 15
) +
labs(x = "Slope by county")
#| label: import relevant datasets
#| echo: false
#| message: false
SoCalRent2025 <- readr::read_csv(here::here("../Data", "2025SoCalRent - Sheet1.csv"))
#| label: libraries
library(tidyverse)
library(janitor)
library(httr2)
library(robotstxt)
library(rstanarm)
#| label: import-relevant-datasets
#| fig-cap: Code to import relevant datasets
SoCalRent2025 <- SoCalRent2025 %>%
mutate(
`sq ft` = str_remove(`sq ft`, ",")
)
#| label: exploring the data
SoCalRent2025 |>
group_by(county) %>%
summarize(
mean_price = mean(price),
n = n()
)
#| label: make separate datasets to do separate explanatory analysis on each county
SoCalRent2025_LAC <- SoCalRent2025 %>%
filter(county == "LA")
SoCalRent2025_OC <- SoCalRent2025 %>%
filter(county == "OC")
SoCalRent2025_RIV <- SoCalRent2025 %>%
filter(county == "RIV")
#| label: two different datasets that base off the range
SoCalRent2025_minimums <- SoCalRent2025 %>%
filter(!is.na(`sq ft`)) %>%
mutate(
`sq ft` = as.numeric(str_extract(`sq ft`, "[0-9]+"))
)
SoCalRent2025_maximums <- SoCalRent2025 %>%
filter(!is.na(`sq ft`)) %>%
mutate(
`sq ft` = as.numeric(if_else(str_detect(`sq ft`, "-"),
true = str_remove(str_extract(`sq ft`, "-[0-9]+$"), "-"),
false = str_extract(`sq ft`, "[0-9]+"))
)
)
#| label: seeing the range of prices for each type of house
ggplot(SoCalRent2025, aes(x = price, y = county)) +
geom_boxplot() +
labs(
x = "Price",
y = "County"
)
SoCalRent2025 %>%
group_by(county) %>%
summarize(
min_price = min(price),
q1_price = quantile(price, 0.25),
med_price = median(price),
q3_price = quantile(price, 0.75),
max_price = max(price)
)
SoCalRent2025 %>%
filter(price >= 20000)
#| label: removing the massive outliers in terms of Price and Square Feet
SoCalRent2025_1 <- SoCalRent2025 %>%
filter(price < 30000) %>%
mutate(
`sq ft` = as.numeric(`sq ft`)
)
SoCalRent2025_1 %>%
group_by(county) %>%
summarize(
mean_price = mean(price)
)
SoCalRent2025_1 %>%
summarize(
min_price = min(price),
q1_price = quantile(price, 0.25),
med_price = median(price),
q3_price = quantile(price, 0.75),
max_price = max(price)
)
ggplot(SoCalRent2025_1, aes(x = `sq ft`, y = type)) +
geom_boxplot()
SoCalRent2025_1 %>%
filter(`sq ft` > 4000)
# ggplot(LaRent_1, aes(x = SqFt, y = Type)) +
#   geom_boxplot()
#
# LaRent_1 %>%
#   summarize(
#     min_sqft = min(SqFt),
#     q1_sqft = quantile(SqFt, 0.25),
#     med_sqft = median(SqFt),
#     q3_sqft = quantile(SqFt, 0.75),
#     max_sqft = max(SqFt)
#   )
#| label: updated plots
SoCalRent2025_1 <- SoCalRent2025_1 %>%
filter(`sq ft` < 4000)
SoCalRent2025_1 %>%
group_by(county) %>%
summarize(
min_price = min(price),
q1_price = quantile(price, 0.25),
med_price = median(price),
q3_price = quantile(price, 0.75),
max_price = max(price)
)
ggplot(SoCalRent2025_1, aes(x = price, y = county)) +
geom_boxplot() +
labs(
x = "Price",
y = "County"
)
# SoCalRent2025_2 <- SoCalRent2025_1 %>%
#   filter(price < 12500)
#
# ggplot(SoCalRent2025_2, aes(x = price, y = county)) +
#   geom_boxplot() +
#   labs(
#     x = "Price",
#     y = "County"
#   )
#
# SoCalRent2025_2 %>%
#   group_by(county) %>%
#   summarize(
#     n = n(),
#     avg_price = mean(price)
#   )
ggplot(SoCalRent2025_1, aes(x = price)) +
geom_histogram(bins = 10) +
labs(
title = "Rent Distrbution by County",
x = "Price",
y = "Count"
) +
theme(
plot.title = element_text(
hjust = 0.5,
size = 24,
face = "bold"
),
plot.margin = margin(t = 10, r = 20, b = 30, l = 10),
axis.title.x = element_text( # X-axis label
size = 20
),
axis.title.y = element_text( # X-axis label
size = 20
),
axis.text.x = element_text(
size = 12
),
axis.text.y = element_text(
size = 16
),
panel.spacing.x = unit(20, "points"),
#strip.clip = "off"
) +
facet_wrap(vars(county), ncol = 3, labeller = labeller(
county = c(
"LA" = "Los Angeles County",
"OC" = "Orange County",
"RIV" = "Riverside County"
)
))
bayes_SoCalRent <- stan_glm(
price ~ county,
data = SoCalRent2025_1,
family = "gaussian",
prior = default_prior_coef(),
prior_intercept = default_prior_intercept(),
seed = 1
)
SoCalRent_dist <- bayes_SoCalRent %>%
as.data.frame()
head(SoCalRent_dist)
plot(
bayes_SoCalRent,
pars = c("countyOC", "countyRIV"),
plotfun = "hist",
bins = 15
) +
labs(x = "Slope by county")
predicted_house <- data.frame(
`sq ft` = c(1000, 2000, 7000)
)
predicted_rents <- bayes_SoCalRent %>%
posterior_predict(
newdata = predicted_house,
draws = 1000,
seed = 1
)
plot(
bayes_SoCalRent,
pars = c("countyOC", "countyRIV"),
plotfun = "hist",
bins = 15
) +
labs(x = "Slope by county")
predicted_house <- data.frame(
`sq ft` = c(1000, 2000, 7000)
)
predicted_rents <- bayes_SoCalRent %>%
posterior_predict(
newdata = predicted_house,
draws = 1000,
seed = 1
)
predicted_house <- data.frame(
county = c("OC", "LA", "RIV")
)
predicted_rents <- bayes_SoCalRent %>%
posterior_predict(
newdata = predicted_house,
draws = 1000,
seed = 1
)
View(predicted_rents)
predicted_rents_df <- predicted_rents %>%
as.data.frame()
ggplot(data = predicted_rents_df,
mapping = aes(x = `1`)
) +
geom_histogram(
bins = 20
) +
labs(title = "Renting a $1000 Sq Ft House",
x = "Rent Price",
y = "Number of Simulated Houses"
)
predicted_rents_df <- predicted_rents %>%
as.data.frame()
ggplot(data = predicted_rents_df,
mapping = aes(x = `1`)
) +
geom_histogram(
bins = 20
) +
labs(title = "Renting a House by county",
x = "Rent Price",
y = "Number of Simulated Houses"
)
bayes_SoCalRent %>%
pp_check()
predicted_rents_df <- predicted_rents %>%
as.data.frame()
ggplot(data = predicted_rents_df,
mapping = aes(x = `1`)
) +
geom_histogram(
bins = 20
) +
labs(title = "Renting a House by county",
x = "Rent Price",
y = "Number of Simulated Houses"
)
bayes_SoCalRent %>%
pp_check()
bayes_SoCalRent <- stan_glm(
price ~ county,
data = SoCalRent2025_1,
family = "gaussian",
prior = normal(location = 3, autoscale = TRUE),
prior_intercept = default_prior_intercept(),
seed = 1
)
SoCalRent_dist <- bayes_SoCalRent %>%
as.data.frame()
head(SoCalRent_dist)
plot(
bayes_SoCalRent,
pars = c("countyOC", "countyRIV"),
plotfun = "hist",
bins = 15
) +
labs(x = "Slope by county")
predicted_house <- data.frame(
county = c("OC", "LA", "RIV")
)
predicted_rents <- bayes_SoCalRent %>%
posterior_predict(
newdata = predicted_house,
draws = 1000,
seed = 1
)
predicted_rents_df <- predicted_rents %>%
as.data.frame()
ggplot(data = predicted_rents_df,
mapping = aes(x = `1`)
) +
geom_histogram(
bins = 20
) +
labs(title = "Renting a House by county",
x = "Rent Price",
y = "Number of Simulated Houses"
)
bayes_SoCalRent %>%
pp_check()
